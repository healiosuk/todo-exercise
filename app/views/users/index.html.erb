<% content_for :title, "Users" %>

<div class="sm:flex sm:items-center sm:justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Users</h1>
  <%= link_to "New user", new_user_path, class: "mt-3 sm:mt-0 inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors" %>
</div>

<div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-300">
    <thead class="bg-gray-50">
      <tr>
        <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Name</th>
        <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Email</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 bg-white">
      <% @users.each do |user| %>
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="py-4 pl-4 pr-3 text-sm font-medium">
            <%= link_to user.full_name, user, class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
          <td class="px-3 py-4 text-sm text-gray-500"><%= user.email %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
