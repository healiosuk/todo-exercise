<div id="<%= dom_id user %>">
  <table class="detail-table">
    <tbody>
      <tr>
        <th>First name</th>
        <td><%= user.first_name %></td>
      </tr>
      <tr>
        <th>Last name</th>
        <td><%= user.last_name %></td>
      </tr>
      <tr>
        <th>Email</th>
        <td><%= user.email %></td>
      </tr>
    </tbody>
  </table>
</div>
