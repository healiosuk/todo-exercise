<p class="notice"><%= notice %></p>

<%= render @user %>

<h2>Todos</h2>

<% if @user.todos.any? %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Complete</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @user.todos.each do |todo| %>
        <tr>
          <td><%= link_to todo.title, todo %></td>
          <td><%= todo.description %></td>
          <td><%= todo.complete ? "Yes" : "No" %></td>
          <td>
            <% unless todo.complete %>
              <%= button_to "Complete", todo, method: :patch, params: { todo: { complete: true } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No todos yet.</p>
<% end %>

<div class="actions">
  <%= link_to "Edit", edit_user_path(@user) %> |
  <%= link_to "Back to users", users_path %>
  <%= button_to "Delete", @user, method: :delete %>
</div>
