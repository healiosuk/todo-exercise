<div id="<%= dom_id todo %>">
  <table class="detail-table">
    <tbody>
      <tr>
        <th>Title</th>
        <td><%= todo.title %></td>
      </tr>
      <tr>
        <th>Description</th>
        <td><%= todo.description %></td>
      </tr>
      <tr>
        <th>User</th>
        <td><%= link_to todo.user.full_name, todo.user %></td>
      </tr>
      <tr>
        <th>Complete</th>
        <td><%= todo.complete ? "Yes" : "No" %></td>
      </tr>
    </tbody>
  </table>
</div>
