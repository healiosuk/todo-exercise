<div id="<%= dom_id todo %>">
  <div>
    <strong>Title:</strong>
    <%= todo.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= todo.description %>
  </div>

  <div>
    <strong>User:</strong>
    <%= todo.user_id %>
  </div>

  <div>
    <strong>Complete:</strong>
    <%= todo.complete %>
  </div>

</div>
