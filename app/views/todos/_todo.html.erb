<div id="<%= dom_id todo %>" class="divide-y divide-gray-100">
  <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
    <dt class="text-sm font-medium text-gray-500">Title</dt>
    <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= todo.title %></dd>
  </div>
  <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
    <dt class="text-sm font-medium text-gray-500">Description</dt>
    <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= todo.description.presence || "—" %></dd>
  </div>
  <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
    <dt class="text-sm font-medium text-gray-500">User</dt>
    <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
      <%= link_to todo.user.full_name, todo.user, class: "text-indigo-600 hover:text-indigo-900" %>
    </dd>
  </div>
  <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
    <dt class="text-sm font-medium text-gray-500">Due Date</dt>
    <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
      <% if todo.due_date %>
        <span class="<%= todo.due_date < Date.today && !todo.complete ? 'text-red-600 font-medium' : 'text-gray-900' %>">
          <%= todo.due_date.strftime("%d %b %Y") %>
          <% if todo.due_date < Date.today && !todo.complete %>
            <span class="ml-1 inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Overdue</span>
          <% end %>
        </span>
      <% else %>
        <span class="text-gray-900">—</span>
      <% end %>
    </dd>
  </div>
  <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
    <dt class="text-sm font-medium text-gray-500">Priority</dt>
    <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= todo.priority.capitalize %></dd>
  </div>
  <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
    <dt class="text-sm font-medium text-gray-500">Status</dt>
    <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
      <% if todo.complete %>
        <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Complete</span>
      <% else %>
        <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-700">Pending</span>
      <% end %>
    </dd>
  </div>
</div>
