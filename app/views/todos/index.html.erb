<p class="notice"><%= notice %></p>

<% content_for :title, "Todos" %>

<h1>Todos</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>User</th>
      <th>Complete</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @todos.each do |todo| %>
      <tr>
        <td><%= todo.title %></td>
        <td><%= todo.description %></td>
        <td><%= link_to todo.user.full_name, todo.user %></td>
        <td><%= todo.complete ? "Yes" : "No" %></td>
        <td><%= link_to "View", todo %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New todo", new_todo_path %>
