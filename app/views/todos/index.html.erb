<p class="notice"><%= notice %></p>

<% content_for :title, "Todos" %>

<h1>Todos</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>User</th>
      <th>Complete</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @todos.each do |todo| %>
      <tr>
        <td><%= link_to todo.title, todo %></td>
        <td><%= todo.description %></td>
        <td><%= link_to todo.user.full_name, todo.user %></td>
        <td><%= todo.complete ? "Yes" : "No" %></td>
        <td>
          <% unless todo.complete %>
            <%= button_to "Complete", todo, method: :patch, params: { todo: { complete: true } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New todo", new_todo_path %>
