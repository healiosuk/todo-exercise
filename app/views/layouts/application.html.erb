<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title><%= content_for(:title) || "TodoApp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <nav class="bg-indigo-600 shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <div class="flex items-center gap-8">
            <%= link_to "TodoApp", todos_path, class: "text-white font-bold text-lg tracking-tight" %>
            <div class="flex items-baseline gap-1">
              <%= link_to "Users", users_path, class: "text-indigo-100 hover:bg-indigo-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors" %>
              <%= link_to "Todos", todos_path, class: "text-indigo-100 hover:bg-indigo-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors" %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <% if notice %>
        <div class="mb-6 rounded-md bg-green-50 border border-green-200 p-4">
          <p class="text-sm font-medium text-green-800"><%= notice %></p>
        </div>
      <% end %>
      <% if alert %>
        <div class="mb-6 rounded-md bg-red-50 border border-red-200 p-4">
          <p class="text-sm font-medium text-red-800"><%= alert %></p>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
